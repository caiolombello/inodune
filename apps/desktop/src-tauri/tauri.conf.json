{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inodune",
  "version": "0.1.10",
  "identifier": "app.inodune.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inodune",
        "width": 1440,
        "height": 960,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "../../../assets/brand/inodune-icon-512.png"
    ],
    "category": "Utility",
    "shortDescription": "Free up space. Preserve what matters.",
    "longDescription": "Local disk cleanup with explicit scopes, protected inventory, impact review and native confirmation. No account, telemetry or administrative permissions.",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/inodune-cli": "../../../target/compat/release/inodune-cli",
          "/usr/share/licenses/inodune/LICENSE": "../../../LICENSE",
          "/usr/bin/inodune-uninstall-helper": "../../../target/compat/release/inodune-uninstall-helper",
          "/usr/share/doc/inodune/copyright": "../../../packaging/debian/copyright",
          "/usr/share/doc/inodune/changelog.gz": "../../../packaging/debian/changelog.gz"
        },
        "section": "utils",
        "depends": [
          "libc6 (>= 2.34)",
          "libgcc-s1"
        ]
      },
      "rpm": {
        "files": {
          "/usr/bin/inodune-cli": "../../../target/compat/release/inodune-cli",
          "/usr/share/licenses/inodune/LICENSE": "../../../LICENSE",
          "/usr/bin/inodune-uninstall-helper": "../../../target/compat/release/inodune-uninstall-helper"
        }
      }
    },
    "publisher": "Caio Barbieri <70986039+caiolombello@users.noreply.github.com>",
    "homepage": "https://github.com/caiolombello/inodune"
  }
}
