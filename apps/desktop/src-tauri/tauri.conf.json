{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inodune",
  "version": "0.0.1",
  "identifier": "app.inodune.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inodune \u00b7 Prot\u00f3tipo",
        "width": 1440,
        "height": 960,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "../../../assets/brand/inodune-icon-512.png"
    ]
  }
}
